{
  "name": "private-news-center",
  "version": "1.1.7",
  "description": "个人实时新闻中心（HTML + Electron 封装）",
  "main": "main.js",
  "author": "PrivateNewsCenter",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^31.3.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.privatenewscenter.app",
    "productName": "实时新闻中心",
    "copyright": "Personal use",
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "assets/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "实时新闻中心-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "实时新闻中心",
      "deleteAppDataOnUninstall": false
    },
    "directories": {
      "output": "dist-installer"
    }
  }
}
